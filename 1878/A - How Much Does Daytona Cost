import java.util.Scanner;
 
public class HowMuchDoesDaytonaCost {
    public static void main(String[] args) {
 
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
 
        while(t-- > 0){
            int n = sc.nextInt();
            int k = sc.nextInt();
            int[] arr = new int[n];
            for (int i = 0; i < n; i++) {
                arr[i] = sc.nextInt();
            }
 
           boolean isPresent = false;
 
            for(int x : arr){
                if(x==k){
                    isPresent = true;
                    break;
                }
            }
            if(isPresent){
                System.out.println("Yes");
            } else{
                System.out.println("No");
            }
 
        }
    }
}